<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.vamsikalagaturu.jackdaw">

    <!-- IMAP, SMTP and ManageSieve, and remote images when asked for -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="jackdaw"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:resizeableActivity="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name=".JackdawActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="jackdaw" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".OpenProvider"
            android:authorities="io.github.vamsikalagaturu.jackdaw.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
