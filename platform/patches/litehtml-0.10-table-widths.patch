 #include "render_table.h"
 #include "document.h"
 #include "iterators.h"
+#include <map>
+#include <set>
+#include <tuple>
+
+namespace
+{
+	// A table measures each cell at its minimum and its maximum width before laying it out, so a table nested n
+	// deep laid its innermost cells out about 3^n times. A cell is a block formatting context: at the same width it
+	// measures the same, so within one document::render each measurement is made once.
+	using measure_key = std::tuple<const litehtml::render_item*, float, int, float, float, int, float, float, uint32_t>;
+	std::map<measure_key, litehtml::rendered_width> measures;
+
+	// A cell whose measurement was kept goes into stale: its layout is not this measurement's, and the second
+	// pass that lays it out finally relies on the first (it skips absolutely positioned children).
+	litehtml::rendered_width measure(const std::shared_ptr<litehtml::render_item>& el,
+									 const litehtml::containing_block_context& cb, litehtml::formatting_context* fmt_ctx,
+									 std::set<const litehtml::render_item*>& stale)
+	{
+		measure_key key{el.get(), cb.width.value, (int)cb.width.type, cb.render_width.value, cb.height.value,
+						(int)cb.height.type, cb.min_width.value, cb.max_width.value, cb.size_mode};
+		auto found = measures.find(key);
+		if(found != measures.end())
+		{
+			stale.insert(el.get());
+			return found->second;
+		}
+		stale.erase(el.get());
+		auto rw = el->render(0, 0, cb, fmt_ctx);
+		measures[key] = rw;
+		return rw;
+	}
+}
+
+void litehtml::table_measures_clear()
+{
+	measures.clear();
+}
 
 
